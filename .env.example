# Standalone model mode; local chat does not require Telegram configuration.
# Real runs need a compatible URL, model name and the endpoint's credentials.
# Future external-host mode may use the host's model; its adapter is not implemented.
# ASCLAW_FAKE_AI=1 can be used for wiring tests.
# ASCLAW_OPENAI_MODEL is the tutorial placeholder ("fake value") kept for reference;
# the real model is selected via the domestic OpenAI-compatible config below.
OPENAI_API_KEY=
ASCLAW_OPENAI_MODEL=gpt-5.5
ASCLAW_FAKE_AI=0

# Domestic model (OpenAI-compatible). The OpenAI Agents SDK interface is kept;
# we only point its client at a domestic endpoint to avoid OpenAI network/cost.
# Provider presets (set ASCLAW_MODEL_PROVIDER + the matching base url/key/name):
#   tencent  -> https://tokenhub.tencentmaas.com/v1   models: hy3, kimi-k2.6, glm-5.2
#   volcengine-> https://ark.cn-beijing.volces.com/api/v3  models: doubao-seed-2-1-turbo-260628, doubao-seed-2-0-lite-260428
ASCLAW_MODEL_PROVIDER=tencent
ASCLAW_MODEL_BASE_URL=https://tokenhub.tencentmaas.com/v1
ASCLAW_MODEL_API_KEY=
ASCLAW_MODEL_NAME=hy3

# Runtime state.
ASCLAW_DATA_DIR=data
ASCLAW_WORKSPACE_DIR=.
# Host display and scheduling timezone. Keep this at the owner's local timezone.
ASCLAW_TIMEZONE=America/Los_Angeles
# A-share trading-date boundary. Independent from the owner's local timezone.
ASCLAW_MARKET_TIMEZONE=Asia/Shanghai

# Tool safety switches.
ASCLAW_ENABLE_BASH=0
ASCLAW_ENABLE_FILE_WRITE=1
ASCLAW_ENABLE_CODEX_TOOL=0

# Optional existing MCP adapters; not yet a hot-swappable data plugin registry.
# Compatible with {"mcpServers": {"name": {"command": "...", "args": []}}}.
ASCLAW_MCP_CONFIG=.mcp.json
ASCLAW_NPM_CACHE=.cache/npm
# Deep-research MCP credentials. Leave blank for keyless/tool-list-only startup.
TAVILY_API_KEY=
TAVILY_HUMAN_ID=
QVERIS_API_KEY=
# Optional: global or cn. Blank lets QVeris infer the region from the key prefix.
QVERIS_REGION=
QVERIS_MAX_RETRIES=3

# Optional prompt asset migration sources. Empty by default; legacy dirs are never auto-loaded.
ASCLAW_SKILL_DIRS=
ASCLAW_PLUGIN_DIRS=

# Optional web search provider. Without this, the fallback uses DuckDuckGo HTML.
BRAVE_SEARCH_API_KEY=

# Optional Telegram adapter (current run command). Leave blank for local chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Telegram Bot API is blocked in mainland China, so the bot needs a proxy to reach
# api.telegram.org. The model client connects directly, so this only affects Telegram
# and web tools. Use an http/https proxy (urllib reads HTTPS_PROXY/HTTP_PROXY).
# HTTPS_PROXY=http://127.0.0.1:<proxy-port>
# HTTP_PROXY=http://127.0.0.1:<proxy-port>
