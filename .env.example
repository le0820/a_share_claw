# Required for Telegram mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Required for real AI runs. ASCLAW_FAKE_AI=1 can be used for wiring tests.
OPENAI_API_KEY=
ASCLAW_OPENAI_MODEL=gpt-5.5
ASCLAW_FAKE_AI=0

# Runtime state.
ASCLAW_DATA_DIR=data
ASCLAW_WORKSPACE_DIR=.
ASCLAW_TIMEZONE=America/Los_Angeles

# Tool safety switches.
ASCLAW_ENABLE_BASH=0
ASCLAW_ENABLE_FILE_WRITE=1
ASCLAW_ENABLE_CODEX_TOOL=0

# Optional MCP config. Compatible with {"mcpServers": {"name": {"command": "...", "args": []}}}.
ASCLAW_MCP_CONFIG=.mcp.json

# Optional prompt asset migration sources. Defaults also include .openclaw skill/plugin dirs.
ASCLAW_SKILL_DIRS=
ASCLAW_PLUGIN_DIRS=

# Optional web search provider. Without this, the fallback uses DuckDuckGo HTML.
BRAVE_SEARCH_API_KEY=
