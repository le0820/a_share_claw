  "unresolved_calibration": [
    "Exact entity universe, metric selection and within-pillar/entity weights; candidates are not an admitted basket",
    "Growth lag and rolling/expanding window per metric; inclusion of current observation and MAD-zero rule",
    "Ratio level/change baseline and direction; comparable GPU generation and quality normalization",
    "Freshness formula uses exp(-age/HalfLife): specify e-folding time or true half-life, values, and observation/publication age basis",
    "Define effective weight coverage versus confidence-weighted denominator, component confidence and total aggregation",
    "Double-count prevention across capex/orders/revenue and effective-supply overlap",
    "Quadrant flat/uncertain cases and comparable growth aggregation; significant gap threshold",
    "CFCE entity basket/currency/share-split normalization and zero/negative denominator; AICEI/PSVG/NSY/WACC missing full formula",
    "Exact source bindings, historical availability/revisions and scope review",
    "Leading performance is a hypothesis; one-quarter use does not validate 1/3/6-month forecasting"
  ],
  "hard_boundaries": [
    "No planned capacity as effective supply",
    "No asset price in core supply-demand index",
    "No missing-as-zero or neutral score",
    "No future availability or unlabelled revisions",
    "No seasonal/quarterly linear interpolation to manufacture daily observations",
    "Training and inference separate; safety/release delay alone is not falling compute",
    "Token price decline alone is not demand decline",
    "CFCE/AICEI/credit remain independent validation layers",
    "No new source enabled by this tool",
    "No trade action or official state promotion",
    "No raw model release/count as deployable capacity",
    "API token/latency measurements do not reveal provider-internal GPU/HBM utilization",
    "Training and inference evidence must both be explicitly specified before formal scoring"
  ],
  "formula_reference": {
    "component": "clip(50 + 0.5 * (DemandScore - SupplyScore), 0, 100)",
    "total": "0.60 * HSDI + 0.40 * MSDI; no reweighting when a component is N/A",
    "robust_z": "clip((x - median(history)) / (1.4826 * MAD(history)), -3, 3)",
    "field_score": "clip(50 + 16.67 * z, 0, 100)",
    "composite": "sum(w * c * score) / sum(w * c); denominator must be positive",
    "confidence": "100 * sum(w * SourceQuality * Freshness * Valid) / sum(w)",
    "breadth": "sum(w * I(growth > 0)) / sum(w); up >= 0.55, down <= 0.45; remaining regimes unresolved"
  }
}
